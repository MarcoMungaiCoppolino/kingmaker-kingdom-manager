# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.*
secrets.*
TOKEN*.txt
# The script that takes the guide's screenshots of on-air.nicegui.io, and
# the raw windows it photographs: a tool of the author's desk, not part of
# the app, and the raw shots carry a name and a token until it has cut them.
tools/shoot_air_guide.py
kingmaker/launcher/guide/air/account.*

# The live game: the database, its backups, the browser sessions
/saves/*
!/saves/README.md
# NiceGUI writes the browser sessions in the working folder if not told otherwise
.nicegui/
*.bak
*.tmp
*.log

# The map image, portraits and tokens uploaded by the table
/assets/*
!/assets/README.md

# The test scene (built from scratch by tests/run_all.py) and the bench data
/tests/scene/
/tests/benches/*.json
# Scratch folders of the author
/prove/
/prova/
/carica_grinbelta.py

# Claude Code session files
.claude/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
.coverage.*
htmlcov/

# Packaging and build output (packaging/build.py: PyInstaller's folders and
# the finished installers)
build/
dist/
/packaging/out/
*.egg-info/
.eggs/

# Local editor and tool configuration
.vscode/
.idea/
*.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Generated by packaging/third_party.py (the build writes it into the installed folder)
/THIRD_PARTY_LICENSES.txt
