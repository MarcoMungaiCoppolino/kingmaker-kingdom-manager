# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.*
secrets.*
TOKEN*.txt
# The raw windows the guide's screenshot tool photographs (the tool itself
# lives outside this repo): they carry a name and a token until it has cut them.
kingmaker/launcher/guide/air/account.*

# The live game: the database, its backups, the browser sessions
/saves/*
!/saves/README.md
# NiceGUI writes the browser sessions in the working folder if not told otherwise
.nicegui/
*.bak
*.tmp
*.log

# The map image, portraits and tokens uploaded by the table
/assets/*
!/assets/README.md

# The test scene (built from scratch by tests/run_all.py) and the bench data
/tests/scene/
/tests/benches/*.json

# The Python environment and its bytecode
.venv/
__pycache__/
*.py[cod]

# Packaging and build output (packaging/build.py: PyInstaller's folders and
# the finished installers)
build/
dist/
/packaging/out/

# Local editor configuration
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Generated by packaging/third_party.py (the build writes it into the installed folder)
/THIRD_PARTY_LICENSES.txt

# The author's private workspace, its own repository cloned here. (His Claude
# Code folder, a junction into it, is excluded per clone in .git/info/exclude,
# which private/setup.ps1 writes: not a thing of this repository.)
/private/
