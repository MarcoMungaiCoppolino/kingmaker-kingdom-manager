# Kingmaker Kingdom Manager — every setting the app reads from the environment.
# Copy this file to `.env` and load it in your shell (or set the variables in
# the terminal / in docker-compose.yml). Every one of them is optional: the
# defaults are the folders next to the code and the local address.

# Where the game lives (the SQLite database, sessions, backups).
# Default: ./saves
#KINGMAKER_DATA_DIR=/path/to/saves

# Where the map image, portraits and tokens live. Default: ./assets
#KINGMAKER_ASSETS_DIR=/path/to/assets

# Address and port to listen on. Default: 127.0.0.1 and 8080.
# `python launch.py --lan` sets the host to 0.0.0.0 for you.
#KINGMAKER_HOST=127.0.0.1
#KINGMAKER_PORT=8080

# Interface language for whoever has not chosen one and whose browser asks
# for nothing supported: en or it. Default: en
#KINGMAKER_LANG=en

# The key that signs the session cookies. Leave it unset and the app makes a
# random one on first start and keeps it in saves/.storage_secret.
#KINGMAKER_STORAGE_SECRET=

# Your NiceGUI On Air token, for `python launch.py --online` with a fixed
# address (free at https://nicegui.io/on_air). Never commit it.
#KINGMAKER_ON_AIR_TOKEN=

# Behind a reverse proxy that terminates HTTPS: mark the session cookie
# Secure, and trust the first X-Forwarded-For hop as the client address.
# Set them only if such a proxy really sits in front of the app.
#KINGMAKER_HTTPS=1
#KINGMAKER_TRUST_PROXY=1

# Log level: INFO (default) or DEBUG.
#KINGMAKER_LOG=INFO
